<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark"
    tools:context=".categorymeals.view.CategoryMealsActivity">

    <ImageView
        android:id="@+id/btnBackCatMealAct"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/baseline_arrow_back_24"
        app:tint="@android:color/white"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/titleCatMealAct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category Meals"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btnBackCatMealAct"
        app:layout_constraintBottom_toBottomOf="@id/btnBackCatMealAct"
        app:layout_constraintStart_toEndOf="@id/btnBackCatMealAct"
        android:layout_marginStart="12dp"/>

    <EditText
        android:id="@+id/searchETCatMealAct"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:hint="Search Meal"
        android:textColor="@android:color/white"
        android:textColorHint="#888888"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/baseline_search_24"
        android:drawablePadding="8dp"
        android:padding="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnBackCatMealAct"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/favoritesRVCatMealAct"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchETCatMealAct" />


</androidx.constraintlayout.widget.ConstraintLayout>